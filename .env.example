# Copy to .env.local. Never commit real values.

# --- Core -------------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data (zero setup, local only).
# Set to a Postgres/Neon connection string for staging and production.
DATABASE_URL=
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. http://localhost:3000 or https://app.example.com
BETTER_AUTH_URL=http://localhost:3000

# --- Administrator ----------------------------------------------------
# The built-in sign-in is created from these values. If either is missing in
# production, no administrator is created (sign-up remains invitation-only).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Set to 1 once to force-reset the admin password after a deploy. Leave unset otherwise.
# ADMIN_RESET_PASSWORD=1

# --- Security ---------------------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts provider OAuth tokens. Required in production.
TOKEN_ENCRYPTION_KEY=
# Shared secret for the scheduler endpoint /api/cron (sent as "Authorization: Bearer <secret>").
CRON_SECRET=

# --- Google integrations (Search Console + Analytics 4) -----------------
# One OAuth client serves both. Google Cloud Console → APIs & Services → enable
# "Google Search Console API", "Google Analytics Data API" and "Google Analytics Admin API" →
# Credentials → OAuth client ID (Web application). Authorised redirect URIs (add both):
#   <BETTER_AUTH_URL>/api/integrations/google_search_console/callback
#   <BETTER_AUTH_URL>/api/integrations/google_analytics/callback
# BETTER_AUTH_URL is also the public origin of hosted blogs (/blog/<workspace>/<product>),
# so set it to your real https domain in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel deployments --------------------------------------------------
# No variable needed: connect in Integrations → Vercel with an access token from
# https://vercel.com/account/settings/tokens (stored encrypted with TOKEN_ENCRYPTION_KEY).

# --- AI agents -----------------------------------------------------------
# Anthropic API key for the Agent Operations Center. Usage is billed to this account and capped per agent.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
AGENT_MODEL=
