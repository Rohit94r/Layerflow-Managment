# Copy to .env.local. Never commit real values.

# Leave empty to use the embedded PGlite database in ./.data (zero setup, local only).
# Set to a Postgres/Neon connection string for staging and production.
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
